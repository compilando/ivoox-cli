STOP = threading.Event()
EPISODE = re.compile(r"_rf_(\d+)_")
KINDS = [("episode", EPISODE), ("list", re.compile(r"_bk_list_(\d+)_")),
         ("program", re.compile(r"_sq_f1(\d+)_"))]
ACCOUNT_PATHS = {
    "/mis-audios_hn.html": ("account-later", "Escuchar más tarde"),
    "/audios-que-me-gustan_hc_recomendados_1.html": ("account-favorites", "Episodios favoritos"),
}


def publication_date(value):
    """Normaliza fechas habituales de HTML/RSS a YYYY-MM-DD."""
    if not value:
        return None
    value = str(value).strip()
    match = re.search(r"(?<!\d)(\d{4})-(\d{2})-(\d{2})(?!\d)", value)
    if match:
        return "-".join(match.groups())
    match = re.search(r"\b(\d{1,2})/(\d{1,2})/(\d{4})\b", value)
    if match:
        day, month, year = match.groups()
        return f"{year}-{int(month):02d}-{int(day):02d}"
    try:
        from email.utils import parsedate_to_datetime
        return parsedate_to_datetime(value).date().isoformat()
    except (TypeError, ValueError, OverflowError):
        return None


def node_publication_date(node):
    """Busca una fecha junto a una tarjeta/fila de episodio."""
    scope = node.find_parent("tr") or node.find_parent(class_="modulo-type-episodio") or node
    for dated in scope.select('time[datetime], [itemprop="datePublished"][content]'):
        value = dated.get("datetime") or dated.get("content")
        if result := publication_date(value):
            return result
    return publication_date(scope.get_text(" ", strip=True))


def log(message):
    print(message, file=sys.stderr, flush=True)


def source(url):
    parts = urlsplit(url)
    host = parts.hostname or ""
    if parts.scheme not in {"https", "http"} or not (
        host == "ivoox.com" or host.endswith(".ivoox.com")
    ) or parts.username or parts.password:
        raise ValueError("Se requiere una URL pública de ivoox.com")
    for kind, pattern in KINDS:
        match = pattern.search(parts.path)
        if match:
            return kind, match[1], urlunsplit(("https", parts.netloc, parts.path, "", ""))
    raise ValueError("URL no reconocida: usa un episodio (_rf_), lista (_bk_list_) o programa (_sq_f1)")


def session(cfg):
    client = requests.Session()
    client.headers.update({"User-Agent": "ivx/1.0 (personal podcast downloader)",
                           "Accept-Encoding": "identity"})
    cookies = cfg / "cookies.txt"
    if cookies.exists():
        jar = http.cookiejar.MozillaCookieJar(str(cookies))
        jar.load(ignore_discard=True, ignore_expires=True)
        for cookie in jar:
            if cookie.expires == 0:
                cookie.expires = None
                cookie.discard = True
            if not cookie.is_expired():
                client.cookies.set_cookie(cookie)
    return client


def html_page(client, url):
    response = client.get(url, timeout=(15, 60))
    response.raise_for_status()
    if "notFound404" in response.text:
        raise ValueError(f"iVoox devuelve una página 404: {url}")
    return BeautifulSoup(response.text, "html.parser")


def account_source(url):
    """Valida una colección privada que iVoox enlaza desde Mi iVoox."""
    parts = urlsplit(url)
    host = parts.hostname or ""
    if parts.scheme not in {"https", "http"} or not (
        host == "ivoox.com" or host.endswith(".ivoox.com")
    ) or parts.username or parts.password:
        raise ValueError("Se requiere una URL de colección de ivoox.com")
    clean = urlunsplit(("https", parts.netloc, parts.path, "", ""))
    if parts.path in ACCOUNT_PATHS:
        key, title = ACCOUNT_PATHS[parts.path]
        return key, title, clean
    match = re.fullmatch(r"/[^/]*_jb_(\d+)_\d+\.html", parts.path)
    if match:
        return f"account-sub-{match[1]}", "Suscripción", clean
    kind, identifier, clean = source(clean)
    return f"{kind}-{identifier}", "Colección", clean


def require_account_page(client, url, ajax=False):
    if ajax:
        response = client.get(url, headers={"X-Requested-With": "XMLHttpRequest"},
                              timeout=(15, 60))
    else:
        response = client.get(url, timeout=(15, 60))
    response.raise_for_status()
    parts = urlsplit(response.url)
    host = parts.hostname or ""
    if not (host == "ivoox.com" or host.endswith(".ivoox.com")):
        raise ValueError("iVoox redirigió la colección fuera de su dominio")
    if "/login_" in parts.path:
        raise ValueError("La sesión de iVoox ha caducado; vuelve a exportar cookies.txt")
    return BeautifulSoup(response.text, "html.parser")


def account_collections(client, config, force=False):
    """Obtiene listas y suscripciones de la cuenta, con caché sin credenciales."""
    cache = config / "account-collections.json"
    if not force and cache.exists() and time.time() - cache.stat().st_mtime < 900:
        try:
            data = json.loads(cache.read_text())
            if isinstance(data, list):
                cache.chmod(0o600)
                return data
        except (OSError, ValueError):
            pass
    lists_url = "https://www.ivoox.com/mis-listas_hk.html"
    lists_page = require_account_page(client, lists_url)
    if not lists_page.select_one("#myListAudios"):
        raise ValueError("iVoox no mostró Mis listas; vuelve a exportar cookies.txt")
    found = {}
    for card in lists_page.select("#myListAudios .modulo-type-lista"):
        anchor = next((a for a in card.select("a[href]")
                       if "_bk_list_" in a["href"] or urlsplit(urljoin(lists_url, a["href"])).path in ACCOUNT_PATHS), None)
        if not anchor:
            continue
        url = urljoin(lists_url, anchor["href"]).split("?")[0]
        key, fallback, url = account_source(url)
        title_node = card.select_one(".title-wrapper")
        title = (title_node or anchor).get_text(" ", strip=True) or fallback
        found[key] = {"key": key, "title": title, "url": url, "account": True,
                      "episodes": [], "loaded": False}
    time.sleep(1.0)
    subscriptions_url = "https://www.ivoox.com/gestionar-suscripciones_je.html"
    subscriptions_page = require_account_page(client, subscriptions_url)
    anchors = subscriptions_page.select('#main a.title[href*="_jb_"]')
    if not anchors:
        raise ValueError("iVoox no mostró Mis suscripciones; vuelve a exportar cookies.txt")
    for anchor in anchors:
        url = urljoin(subscriptions_url, anchor["href"]).split("?")[0]
        key, _, url = account_source(url)
        found[key] = {"key": key, "title": anchor.get_text(" ", strip=True), "url": url,
                      "account": True, "episodes": [], "loaded": False}
    result = sorted(found.values(), key=lambda item: item["title"].casefold())
    config.mkdir(parents=True, exist_ok=True, mode=0o700)
    atomic_json(cache, result)
    cache.chmod(0o600)
    return result


def account_episode_page(client, url, next_url=None):
    """Lee una página inicial o AJAX y devuelve (episodios, siguiente URL)."""
    account_source(url)
    page_url = next_url or url
    soup = require_account_page(client, page_url, ajax=bool(next_url))
    anchors = soup.select('#suscriptions a.title[href*="_rf_"]')
    if not anchors:
        scope = soup.select_one("#listenLater, #myFavouriteAudios") or soup
        anchors = scope.select('.modulo-type-episodio h2 a[href*="_rf_"], '
                               '.modulo-type-episodio .title-wrapper a[href*="_rf_"], '
                               'tr a.title[href*="_rf_"]')
    episodes = {}
    for anchor in anchors:
        link = urljoin(url, anchor["href"]).split("#")[0].split("?")[0]
        match = EPISODE.search(link)
        if match:
            title = anchor.get_text(" ", strip=True) or f"Episodio {match[1]}"
            episodes.setdefault(match[1], {"id": match[1], "url": link, "title": title,
                                           "published": node_publication_date(anchor)})
    items = list(episodes.values())
    following = None
    pagination = soup.select_one('[data-trigger="ajax_pagination"][data-href][data-page]')
    if pagination and items:
        following = urljoin(url, f'{pagination["data-href"]}_{pagination["data-page"]}.html')
    elif next_url and len(items) >= 20:
        match = re.fullmatch(r"(.+_)(\d+)(\.html)(?:\?.*)?", next_url)
        if match:
            following = f"{match[1]}{int(match[2]) + 1}{match[3]}"
    if following:
        parts = urlsplit(following)
        host = parts.hostname or ""
        if parts.scheme != "https" or not (
                host == "ivoox.com" or host.endswith(".ivoox.com")):
            raise ValueError("Endpoint de paginación de cuenta no válido")
    return items, following


def account_episodes(client, url, limit=20, delay=1.0):
    """Recorre la paginación AJAX de una colección privada."""
    episodes = {}
    next_url = None
    first = True
    visited = set()
    while first or next_url:
        page_url = next_url or url
        if page_url in visited:
            break
        visited.add(page_url)
        if not first:
            time.sleep(delay)
        items, next_url = account_episode_page(client, url, next_url)
        first = False
        if not items:
            break
        added = 0
        for episode in items:
            if episode["id"] not in episodes:
                episodes[episode["id"]] = episode
                added += 1
            if limit and len(episodes) >= limit:
                return list(episodes.values())
        if not added:
            break
    return list(episodes.values())


def page_episodes(soup, url, kind):
    # Las listas clásicas y los programas nuevos tienen estructuras distintas.
    tabs = soup.select_one("#tabs") if kind == "program" else None
    scope = tabs.parent if tabs else soup
    anchors = scope.select('.modulo-type-episodio h2 a[href*="_rf_"]')
    if not anchors:
        anchors = scope.select('h3 a[href*="_rf_"], h2 a[href*="_rf_"]')
    found = {}
    for anchor in anchors:
        link = urljoin(url, anchor["href"]).split("#")[0].split("?")[0]
        match = EPISODE.search(link)
        if match:
            found.setdefault(match[1], {"id": match[1], "url": link,
                                      "title": anchor.get_text(" ", strip=True),
                                      "published": node_publication_date(anchor)})
    return list(found.values())


def next_page(soup, url, kind, identifier):
    pattern = (rf"_bk_list_{identifier}_(\d+)\.html" if kind == "list"
               else rf"_sq_f1{identifier}_(\d+)\.html")
    current = re.search(pattern, url)
    number = int(current[1]) if current else 1
    for anchor in soup.select("a[href]"):
        link = urljoin(url, anchor["href"])
        match = re.search(pattern, urlsplit(link).path)
        if match and int(match[1]) == number + 1:
            source(link)
            return link.split("#")[0]
    return None


def discover(client, url, limit=None, no_rss=False, max_pages=None, delay=1.5):
    kind, identifier, url = source(url)
    if kind == "episode":
        return [{"id": identifier, "url": url, "title": f"Episodio {identifier}"}], "episode", 1
    soup = html_page(client, url)
    if kind == "program" and not no_rss:
        feed = soup.select_one('a[href*="_fg_f"], link[type="application/rss+xml"]')
        if feed:
            try:
                feed_url = urljoin(url, feed["href"])
                response = client.get(feed_url, timeout=(15, 60))
                response.raise_for_status()
                root = ET.fromstring(response.content)
                episodes = {}
                for item in root.findall("./channel/item"):
                    link = item.findtext("link", "")
                    match = EPISODE.search(link)
                    enclosure = item.find("enclosure")
                    if match and enclosure is not None and enclosure.get("url"):
                        episodes.setdefault(match[1], {"id": match[1], "url": link,
                            "title": item.findtext("title", match[1]), "media": enclosure.get("url"),
                            "published": publication_date(item.findtext("pubDate", ""))})
                if episodes:
                    log(f"RSS: {feed_url}")
                    return list(episodes.values())[:limit], "rss", 1
                log("RSS sin episodios descargables; usando HTML")
            except (requests.RequestException, ET.ParseError) as exc:
                log(f"RSS no disponible ({type(exc).__name__}); usando HTML")
    episodes = {}
    visited = set()
    pages = 0
    while url and url not in visited:
        visited.add(url)
        pages += 1
        log(f"HTML página {pages}: {url}")
        items = page_episodes(soup, url, kind)
        added = 0
        for episode in items:
            if episode["id"] not in episodes:
                episodes[episode["id"]] = episode
                added += 1
        if not added:
            raise ValueError(f"Página sin episodios nuevos: {url}; revisa selectores/paginación")
        if (limit and len(episodes) >= limit) or (max_pages and pages >= max_pages):
            break
        url = next_page(soup, url, kind, identifier)
        if url:
            time.sleep(delay)
            soup = html_page(client, url)
    return list(episodes.values())[:limit], "html", pages


def media_url(client, episode):
    if episode.get("media"):
        return episode["media"]
    soup = html_page(client, episode["url"])
    title = soup.select_one("h1")
    if title:
        episode["title"] = title.get_text(" ", strip=True)
    # Ruta publicada en el estado de la página, sin ejecutar JavaScript remoto.
    text = str(soup).replace(r"\u002F", "/").replace(r"\/", "/")
    if not episode.get("published"):
        dated = soup.select_one('time[datetime], [itemprop="datePublished"][content]')
        value = (dated.get("datetime") or dated.get("content")) if dated else None
        match_date = re.search(r'"(?:datePublished|uploadDate)"\s*:\s*"([^"]+)"', text)
        episode["published"] = publication_date(value or (match_date[1] if match_date else None))
    match = re.search(rf'/listen_mn_{episode["id"]}_\d+\.mp3', text)
    if match:
        return urljoin(episode["url"], match[0])
    response = client.get(
        f'https://vcore-web.ivoox.com/v1/public/audios/{episode["id"]}/download-url',
        timeout=(15, 60),
    )
    response.raise_for_status()
    data = response.json()
    for obj in [data, data.get("data", {})] if isinstance(data, dict) else []:
        if isinstance(obj, dict):
            for key in ("url", "downloadUrl", "download_url"):
                if isinstance(obj.get(key), str) and obj[key].startswith("https://"):
                    return obj[key]
    raise ValueError(f'Sin audio público descargable: {episode["url"]}')


def atomic_json(path, data):
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n")
    temporary.replace(path)


def audio_file(path):
    result = subprocess.run(["file", "--brief", "--mime-type", str(path)],
                            capture_output=True, text=True, check=True)
    if result.stdout.strip().startswith("audio/"):
        return
    if shutil.which("ffprobe"):
        probe = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "stream=codec_type",
                                "-of", "json", str(path)], capture_output=True, text=True, check=True)
        if any(s.get("codec_type") == "audio" for s in json.loads(probe.stdout).get("streams", [])):
            return
    else:
        description = subprocess.check_output(["file", "--brief", str(path)], text=True)
        if "Audio file" in description or "MPEG ADTS" in description:
            return
    raise ValueError(f"La respuesta no es audio: {path.name} ({result.stdout.strip()})")


def download(episode, folder, cfg, rate=0):
    target = folder / f'{episode["id"]}.mp3'
    if target.exists() and target.stat().st_size:
        metadata = target.with_suffix(".json")
        try:
            saved_episode = json.loads(metadata.read_text()) if metadata.exists() else {}
        except (OSError, ValueError):
            saved_episode = {}
        enriched = {**saved_episode,
                    **{key: value for key, value in episode.items() if value is not None}}
        if enriched != saved_episode:
            atomic_json(metadata, enriched)
        return False
    partial = target.with_suffix(".mp3.part")
    meta = target.with_suffix(".mp3.part.json")
    with session(cfg) as client:
        offset = partial.stat().st_size if partial.exists() else 0
        saved = json.loads(meta.read_text()) if offset and meta.exists() else {}
        url = saved.get("url") or media_url(client, episode)
        overlap = min(offset, 4096) if saved else 0
        start = offset - overlap if saved else 0
        headers = {"Range": f"bytes={start}-"} if offset and saved else {}
        if headers and saved.get("validator"):
            headers["If-Range"] = saved["validator"]
        with client.get(url, headers=headers, stream=True, timeout=(15, 60)) as response:
            response.raise_for_status()
            length = response.headers.get("Content-Length")
            total = int(length) if length else None
            resumed = bool(headers and response.status_code == 206)
            if response.status_code == 206:
                match = re.fullmatch(r"bytes (\d+)-(\d+)/(\d+)",
                                     response.headers.get("Content-Range", ""))
                if not match or int(match[1]) != start:
                    raise ValueError("Content-Range inesperado; se conserva el parcial")
                total = int(match[3])
                if saved.get("total") and total != saved["total"]:
                    raise ValueError("El audio remoto cambió de tamaño; se conserva el parcial")
            content_type = response.headers.get("Content-Type", "").split(";")[0]
            if content_type.startswith("text/") or "json" in content_type:
                raise ValueError(f"iVoox devolvió {content_type}, no audio")
            if not resumed:
                offset = overlap = 0
            else:
                log(f'RESUME {episode["id"]}: HTTP 206 desde {offset} bytes')
            etag = response.headers.get("ETag", "")
            validator = etag if etag and not etag.startswith("W/") else response.headers.get("Last-Modified")
            atomic_json(meta, {"url": response.url, "total": total, "validator": validator})
            chunks = response.iter_content(64 * 1024)
            # Verificar solapamiento evita unir audios diferentes por publicidad dinámica.
            prefix = b""
            while len(prefix) < overlap:
                block = next(chunks, b"")
                if not block:
                    raise ValueError("Respuesta parcial vacía")
                prefix += block
            if overlap:
                with partial.open("rb") as previous:
                    previous.seek(offset - overlap)
                    if previous.read(overlap) != prefix[:overlap]:
                        raise ValueError("El audio remoto cambió; se conserva el parcial sin mezclarlo")
            with partial.open("ab" if resumed else "wb") as output:
                if prefix:
                    output.write(prefix[overlap:])
                for chunk in chunks:
                    if STOP.is_set():
                        raise InterruptedError("Descarga interrumpida; parcial conservado")
                    output.write(chunk)
                    output.flush()
                    if rate:
                        STOP.wait(len(chunk) / rate)
                output.flush()
                os.fsync(output.fileno())
            if total is not None and partial.stat().st_size != total:
                raise ValueError("Descarga incompleta; parcial conservado")
            audio_file(partial)
            partial.replace(target)
            meta.unlink(missing_ok=True)
            atomic_json(target.with_suffix(".json"), episode)
            log(f'Descargado: {episode["id"]} — {episode["title"]}')
            return True


def write_playlist(folder):
    lines = ["#EXTM3U"]
    for path in sorted(folder.glob("*.mp3")):
        metadata = path.with_suffix(".json")
        title = json.loads(metadata.read_text()).get("title", path.stem) if metadata.exists() else path.stem
        lines.extend(["#EXTINF:-1," + " ".join(title.splitlines()), path.name])
    temporary = folder / "playlist.m3u.tmp"
    temporary.write_text("\n".join(lines) + "\n")
    temporary.replace(folder / "playlist.m3u")


def download_queue(episodes, folder, config, jobs=1, rate=0, state_path=None):
    """Procesa una cola acotada; los .part hacen cada tarea reanudable."""
    work = queue.Queue(maxsize=max(2, jobs * 2))
    lock = threading.Lock()
    result = {"downloaded": 0, "skipped": 0, "failed": 0}
    completed = set()
    failures = {}

    def save_state():
        if state_path:
            try:
                atomic_json(state_path, {
                    "status": ("failed" if failures else
                               "complete" if len(completed) == len(episodes) else "running"),
                    "total": len(episodes), "completed": sorted(completed), "failed": failures,
                    "updated": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                })
            except OSError as exc:
                log(f"AVISO: no se pudo guardar el estado de la cola: {exc}")

    def worker():
        while True:
            episode = work.get()
            try:
                if episode is None:
                    return
                try:
                    changed = download(episode, folder, config, rate)
                    with lock:
                        result["downloaded" if changed else "skipped"] += 1
                        completed.add(episode["id"])
                        failures.pop(episode["id"], None)
                        save_state()
                        done = sum(result.values())
                    log(f'COLA {done}/{len(episodes)} · {episode["id"]}')
                except (ValueError, OSError, requests.RequestException,
                        subprocess.SubprocessError) as exc:
                    with lock:
                        result["failed"] += 1
                        failures[episode["id"]] = str(exc)
                        save_state()
                    log(f"ERROR: {type(exc).__name__}: {exc}")
            finally:
                work.task_done()

    threads = [threading.Thread(target=worker, daemon=True) for _ in range(jobs)]
    for thread in threads:
        thread.start()
    for episode in episodes:
        work.put(episode)
    for _ in threads:
        work.put(None)
    work.join()
    for thread in threads:
        thread.join()
    return result


def get(args, url, archive=False):
    try:
        kind, identifier, _ = source(url)
    except ValueError as public_error:
        try:
            key, _, url = account_source(url)
        except ValueError:
            raise public_error from None
        if archive and not key.startswith("account-sub-"):
            raise ValueError("archive requiere un programa público o una suscripción")
        with session(args.config) as client:
            episodes = account_episodes(
                client, url, None if archive else getattr(args, "n", None),
                delay=max(0, args.delay))
        method, pages = "account", max(1, (len(episodes) + 19) // 20)
    else:
        if archive and kind != "program":
            raise ValueError("archive requiere un programa público o una suscripción")
        key = f"{kind}-{identifier}"
        with session(args.config) as client:
            episodes, method, pages = discover(client, url, None if archive else args.n, args.no_rss,
                                               delay=args.delay)
    if not episodes:
        raise ValueError("No se encontraron episodios")
    folder = args.directory / key
    if archive and args.plan:
        print(json.dumps({"episodes": len(episodes), "method": method, "pages": pages,
                          "directory": str(folder)}, ensure_ascii=False))
        return False
    folder.mkdir(parents=True, exist_ok=True)
    counts = download_queue(episodes, folder, args.config, args.j, args.rate,
                            folder / "archive-state.json" if archive else None)
    write_playlist(folder)
    result = {**counts, "method": method, "pages": pages, "directory": str(folder)}
    print(json.dumps(result, ensure_ascii=False), flush=True)
    return bool(counts["failed"])


def positive(value):
    value = int(value)
    if value < 1:
        raise argparse.ArgumentTypeError("debe ser mayor que cero")
    return value


class MpvPlayer:
    """Un mpv propio, controlado por IPC local; nunca toca otros reproductores."""

    def __init__(self, audio_output=None, cookies_file=None):
        self.audio_output = audio_output
        self.cookies_file = cookies_file
        self.process = None
        self.temporary = None
        self.socket = None
        self.start_lock = asyncio.Lock()

    async def start(self):
        async with self.start_lock:
            if self.process and self.process.returncode is None:
                return
            await self.close()
            self.temporary = tempfile.TemporaryDirectory(prefix="ivx-player-")
            self.socket = str(Path(self.temporary.name) / "mpv.sock")
            command = ["mpv", "--no-config", "--no-video", "--idle=yes", "--terminal=no",
                       "--no-resume-playback", f"--input-ipc-server={self.socket}"]
            if self.cookies_file and Path(self.cookies_file).is_file():
                command.extend(["--cookies=yes", f"--cookies-file={self.cookies_file}"])
            if self.audio_output:
                command.append(f"--ao={self.audio_output}")
            self.process = await asyncio.create_subprocess_exec(
                *command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            for _ in range(100):
                if Path(self.socket).exists():
                    return
                if self.process.returncode is not None:
                    break
                await asyncio.sleep(0.05)
            await self.close()
            raise OSError("No se pudo iniciar mpv; comprueba make deps")

    async def command(self, *command):
        if not self.process or self.process.returncode is not None:
            raise OSError("El reproductor no está iniciado; selecciona un episodio")
        async with asyncio.timeout(2):
            reader, writer = await asyncio.open_unix_connection(self.socket)
            try:
                writer.write((json.dumps({"command": command, "request_id": 1}) + "\n").encode())
                await writer.drain()
                while line := await reader.readline():
                    result = json.loads(line)
                    if result.get("request_id") == 1:
                        if result.get("error") != "success":
                            raise ValueError(f'mpv: {result.get("error", "error desconocido")}')
                        return result.get("data")
                raise OSError("Se cerró la conexión con mpv")
            finally:
                writer.close()
                await writer.wait_closed()

    async def play(self, path):
        await self.start()
        target = str(path)
        if not target.startswith(("https://", "http://")):
            target = str(Path(target).resolve())
        await self.command("loadfile", target, "replace")
        await self.command("set_property", "pause", False)

    async def close(self):
        if self.process and self.process.returncode is None:
            self.process.terminate()
            try:
                await asyncio.wait_for(self.process.wait(), 3)
            except TimeoutError:
                self.process.kill()
                await self.process.wait()
        self.process = None
        if self.temporary:
            self.temporary.cleanup()
            self.temporary = None


def library_collections(directory, config):
    """Une carpetas descargadas y fuentes, sin red ni escrituras."""
    groups = {}
    warnings = []
    sources = config / "sources.txt"
    if sources.exists():
        for line in sources.read_text().splitlines():
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            try:
                kind, identifier, url = source(line.strip())
            except ValueError:
                warnings.append("Hay una URL no válida en sources.txt")
                continue
            slug = urlsplit(url).path.rsplit("/", 1)[-1].split("_")[0]
            title = slug.removeprefix("podcast-").replace("-", " ").strip().capitalize()
            key = f"{kind}-{identifier}"
            groups[key] = {"key": key, "title": title or key, "url": url, "episodes": []}
    for folder in sorted(directory.glob("*")):
        if not folder.is_dir() or not re.fullmatch(
            r"(?:(?:episode|list|program)-\d+|account-(?:later|favorites|sub-\d+))", folder.name
        ):
            continue
        group = groups.setdefault(folder.name, {"key": folder.name, "title": folder.name,
                                               "url": None, "episodes": []})
        for audio in sorted(folder.glob("*.mp3"), key=lambda p: p.stat().st_mtime, reverse=True):
            if not audio.stat().st_size:
                continue
            data = {}
            try:
                data = json.loads(audio.with_suffix(".json").read_text())
                title = str(data.get("title", audio.stem))
            except (OSError, ValueError, AttributeError):
                title = audio.stem
                warnings.append(f"Metadatos ausentes o dañados: {audio.name}")
            group["episodes"].append({"id": audio.stem, "path": audio.resolve(),
                                      "url": data.get("url"),
                                      "published": publication_date(data.get("published")),
                                      "title": " ".join(title.splitlines())})
        if folder.name.startswith("episode-") and group["episodes"]:
            group["title"] = group["episodes"][0]["title"]
    ordered = sorted(groups.values(), key=lambda g: g["title"].casefold())
    all_episodes = [episode for group in ordered for episode in group["episodes"]]
    return [{"key": "all", "title": "Toda la biblioteca", "url": None,
             "episodes": all_episodes}, *ordered], warnings


def merge_collections(local, account):
    """Superpone colecciones de cuenta y archivos locales por ID estable."""
    all_local, local_groups = local[0], {group["key"]: group for group in local[1:]}
    merged = []
    account_keys = set()
    for remote in account:
        account_keys.add(remote["key"])
        group = dict(remote)
        local_group = local_groups.get(remote["key"], {})
        local_by_id = {episode["id"]: episode for episode in local_group.get("episodes", [])}
        if group.get("loaded"):
            episodes = []
            for episode in group.get("episodes", []):
                item = dict(episode)
                if episode["id"] in local_by_id:
                    item["path"] = local_by_id[episode["id"]]["path"]
                episodes.append(item)
            group["episodes"] = episodes
        else:
            group["episodes"] = list(local_group.get("episodes", []))
        merged.append(group)
    merged.extend(group for key, group in local_groups.items() if key not in account_keys)
    merged.sort(key=lambda group: (not group.get("account", False), group["title"].casefold()))
    return [all_local, *merged]


def fetch_account_collections(config, force=False):
    with session(config) as client:
        return account_collections(client, config, force)


def fetch_account_episodes(config, url, limit=20):
    with session(config) as client:
        return account_episodes(client, url, limit)


def fetch_account_episode_page(config, url, next_url=None):
    with session(config) as client:
        return account_episode_page(client, url, next_url)


def resolve_media(config, episode):
    with session(config) as client:
        return media_url(client, episode)


def create_tui(args, player=None):
    """Carga Textual solo al abrir la interfaz; mantiene ivx como script único."""
    from rich.text import Text
    from textual import work
    from textual.app import App, ComposeResult
    from textual.binding import Binding
    from textual.containers import Horizontal, Vertical
    from textual.screen import ModalScreen
    from textual.widgets import Button, DataTable, Footer, Input, ProgressBar, Static

    class AddSource(ModalScreen):
        BINDINGS = (("escape", "dismiss(None)", "Cancelar"),)

        def compose(self) -> ComposeResult:
            with Vertical(id="add-box"):
                yield Static("Añadir una colección", classes="heading")
                yield Input(placeholder="Pega la URL del programa o lista de iVoox", id="source-url")
                yield Static("Enter · guardar     Esc · cancelar", classes="muted")

        def on_mount(self):
            self.query_one(Input).focus()

        def on_input_submitted(self, event: Input.Submitted):
            try:
                source(event.value.strip())
            except ValueError as exc:
                self.notify(str(exc), severity="error")
                return
            self.dismiss(event.value.strip())

    class ConfirmArchive(ModalScreen):
        BINDINGS = (("y", "dismiss(True)", "Sí"), ("n", "dismiss(False)", "No"),
                    ("escape", "dismiss(False)", "Cancelar"))

        def __init__(self, title):
            super().__init__()
            self.podcast_title = title

        def compose(self) -> ComposeResult:
            with Vertical(id="archive-box"):
                yield Static("Archivar el podcast completo", classes="heading")
                yield Static(self.podcast_title, id="archive-title", markup=False)
                yield Static("Se descargarán todos los episodios. Puedes salir y reanudar después.",
                             classes="muted")
                with Horizontal(id="archive-actions"):
                    yield Button("Archivar", id="archive-confirm", variant="warning")
                    yield Button("Cancelar", id="archive-cancel")

        def on_button_pressed(self, event: Button.Pressed):
            event.stop()
            self.dismiss(event.button.id == "archive-confirm")

    class LibraryTable(DataTable):
        BINDINGS = (Binding("j", "cursor_down", show=False), Binding("k", "cursor_up", show=False),
                    Binding("g", "scroll_top", show=False), Binding("G", "scroll_bottom", show=False),
                    Binding("left", "app.seek(-10)", show=False),
                    Binding("right", "app.seek(10)", show=False))

    class IvoxApp(App):
        TITLE = "ivx"
        ENABLE_COMMAND_PALETTE = False
        CSS = """
        Screen { background: #10151d; color: #dce4ee; }
        #brand { height: 3; padding: 1 2; color: #6ed5b1; text-style: bold; }
        #browser { height: 1fr; padding: 0 1; }
        #collection-pane { width: 32%; min-width: 22; height: 1fr; }
        #collection-search { height: 3; }
        #collections { width: 100%; height: 1fr; border: round #344355; }
        #episode-pane { width: 1fr; margin-left: 1; }
        #collection-title { height: 2; padding: 0 1; color: #6ed5b1; }
        #episodes { height: 1fr; border: round #344355; }
        #pagination { display: none; height: 3; padding: 0 1; }
        #pagination.visible { display: block; }
        #pagination-status { width: 1fr; height: 3; padding: 1 1; color: #a9b9cb; }
        #load-all { width: 24; height: 3; min-width: 20; }
        DataTable:focus { border: round #6ed5b1; }
        DataTable { overflow-x: hidden; }
        DataTable > .datatable--cursor { background: #245447; color: #ffffff; }
        DataTable > .datatable--header { background: #1b2532; color: #8facc4; }
        #search { display: none; margin: 0 1; height: 3; }
        #search.visible { display: block; }
        #notice { height: 2; padding: 0 2; color: #a9b9cb; }
        #player { height: 5; margin: 0 1; padding: 0 1; border: round #344355; }
        #now-playing { height: 1; }
        #timeline { height: 1; color: #a9b9cb; }
        #progress { width: 100%; height: 1; }
        Footer { background: #1b2532; }
        AddSource, ConfirmArchive { align: center middle; background: #000000 65%; }
        #add-box { width: 72; max-width: 95%; height: 9; border: round #6ed5b1;
                   background: #1b2532; padding: 1 2; }
        #archive-box { width: 72; max-width: 95%; height: 15; border: round #d9a441;
                       background: #1b2532; padding: 1 2; }
        #archive-title { height: 2; color: #f4d58d; text-style: bold; }
        #archive-actions { height: 3; margin-top: 1; align-horizontal: right; }
        #archive-actions Button { width: 16; margin-left: 1; }
        .heading { height: 2; text-style: bold; }
        .muted { color: #a9b9cb; margin-top: 1; }
        """
        BINDINGS = (
            Binding("space", "pause", "Play/pausa"), Binding("s", "stop", "Stop"),
            Binding("n", "next_episode", "Siguiente", show=False),
            Binding("p", "previous_episode", "Anterior", show=False),
            Binding("left", "seek(-10)", "−10 s", show=False),
            Binding("right", "seek(10)", "+10 s", show=False),
            Binding("minus", "volume(-5)", "Vol −", show=False),
            Binding("plus,equals", "volume(5)", "Vol +", show=False),
            Binding("slash", "search", "Buscar"), Binding("escape", "back", "Volver", show=False),
            Binding("f", "collection_search", "Buscar podcasts", show=False),
            Binding("o", "sort", "Ordenar"),
            Binding("a", "add_source", "Añadir"), Binding("u", "sync_source", "Descargar"),
            Binding("U", "archive_source", "Archivar todo"),
            Binding("m", "load_more", "Más episodios", show=False),
            Binding("M", "load_all", "Cargar lista", show=False),
            Binding("r", "refresh_account", "Mi iVoox"),
            Binding("question_mark", "help", "Ayuda"), Binding("q", "quit", "Salir"),
        )

        def __init__(self):
            super().__init__()
            self.player = player or MpvPlayer(cookies_file=args.config / "cookies.txt")
            self.groups = []
            self.visible_groups = []
            self.account_groups = []
            self.group_key = "all"
            self.visible_episodes = []
            self.sort_mode = "newest"
            self.queue = []
            self.queue_index = -1
            self.now_title = "Nada en reproducción"
            self.job = None
            self.busy = False
            self.stopped = True
            self.closed = False

        def compose(self) -> ComposeResult:
            yield Static("ivx  /  Tu biblioteca de podcasts", id="brand")
            with Horizontal(id="browser"):
                with Vertical(id="collection-pane"):
                    yield Input(placeholder="Filtrar podcasts…  (f)", id="collection-search")
                    yield LibraryTable(id="collections", cursor_type="row", show_row_labels=False)
                with Vertical(id="episode-pane"):
                    yield Static("Toda la biblioteca", id="collection-title", markup=False)
                    yield LibraryTable(id="episodes", cursor_type="row", show_row_labels=False)
                    with Horizontal(id="pagination"):
                        yield Static("", id="pagination-status", markup=False)
                        yield Button("Cargar toda la lista", id="load-all", variant="primary")
            yield Input(placeholder="Filtrar episodios…  Enter: volver a la lista · Esc: limpiar", id="search")
            yield Static("Tab cambia de panel · ↑↓ / j k navegan · Enter reproduce", id="notice", markup=False)
            with Vertical(id="player"):
                yield Static("■  Nada en reproducción", id="now-playing", markup=False)
                yield Static("00:00 / 00:00", id="timeline", markup=False)
                yield ProgressBar(total=100, show_eta=False, show_percentage=False, id="progress")
            yield Footer()

        def on_mount(self):
            self.query_one("#collections", DataTable).add_column("Audios · Colección")
            episodes = self.query_one("#episodes", DataTable)
            episodes.add_column("Fecha", width=10)
            episodes.add_column("Episodio")
            self.action_refresh_library()
            self.query_one("#collections").focus()
            self.set_interval(0.5, self.update_player)
            if not getattr(args, "local_only", False):
                self.load_account_collections()

        def notice(self, message):
            self.query_one("#notice", Static).update(message)

        def action_refresh_library(self):
            try:
                local, warnings = library_collections(args.directory, args.config)
                self.groups = merge_collections(local, self.account_groups)
            except OSError as exc:
                self.notice(f"No se puede leer la biblioteca: {exc}")
                return
            self.refresh_collection_table()
            if warnings:
                self.notice(warnings[0])

        def clear_episode_filter(self):
            field = self.query_one("#search", Input)
            field.value = ""
            field.remove_class("visible")

        def refresh_collection_table(self):
            query = self.query_one("#collection-search", Input).value.casefold().strip()
            self.visible_groups = [group for group in self.groups
                                   if query in group["title"].casefold()]
            table = self.query_one("#collections", DataTable)
            with table.prevent(DataTable.RowHighlighted):
                table.clear()
                for group in self.visible_groups:
                    count = str(len(group["episodes"])) if group.get("loaded") or not group.get("account") else "…"
                    marker = "☁" if group.get("account") else "⌂"
                    table.add_row(Text(f'{marker} {count} · {group["title"]}'), key=group["key"])
                if not self.visible_groups:
                    self.visible_episodes = []
                    self.query_one("#episodes", DataTable).clear()
                    self.query_one("#collection-title", Static).update("Sin podcasts coincidentes")
                    self.query_one("#pagination").remove_class("visible")
                    self.notice("Ningún podcast coincide · Esc limpia el filtro")
                    return
                selected = next((i for i, g in enumerate(self.visible_groups)
                                 if g["key"] == self.group_key), 0)
                table.move_cursor(row=selected)
            new_key = self.visible_groups[selected]["key"]
            if new_key != self.group_key:
                self.clear_episode_filter()
            self.group_key = new_key
            self.show_episodes()

        def show_episodes(self):
            group = next((g for g in self.groups if g["key"] == self.group_key), None)
            if not group:
                return
            query = self.query_one("#search", Input).value.casefold()
            filtered = [e for e in group["episodes"] if query in e["title"].casefold()]
            if self.sort_mode == "newest":
                self.visible_episodes = sorted(
                    filtered, key=lambda e: (bool(e.get("published")), e.get("published") or ""),
                    reverse=True)
            elif self.sort_mode == "oldest":
                self.visible_episodes = sorted(
                    filtered, key=lambda e: (not bool(e.get("published")), e.get("published") or ""))
            else:
                self.visible_episodes = sorted(filtered, key=lambda e: e["title"].casefold())
            table = self.query_one("#episodes", DataTable)
            table.clear()
            for index, episode in enumerate(self.visible_episodes):
                marker = "●" if episode.get("path") else "↓"
                table.add_row(episode.get("published") or "—",
                              Text(f'{marker}  {episode["title"]}'), key=str(index))
            labels = {"newest": "más nuevos", "oldest": "más antiguos", "title": "A–Z"}
            self.query_one("#collection-title", Static).update(
                f'{group["title"]}  ·  {labels[self.sort_mode]}')
            pagination = self.query_one("#pagination")
            button = self.query_one("#load-all", Button)
            if group.get("next_url"):
                pagination.add_class("visible")
                button.disabled = bool(group.get("loading"))
                button.label = "Cargando…" if group.get("loading") else "Cargar toda la lista"
                self.query_one("#pagination-status", Static).update(
                    f'{len(group["episodes"])} cargados · quedan más páginas')
            else:
                pagination.remove_class("visible")
            if not group["episodes"]:
                if group.get("account") and not group.get("loaded"):
                    self.notice("Colección de tu cuenta · Enter carga sus episodios")
                else:
                    self.notice("Sin audios. Pulsa u para descargar esta fuente." if group["url"] else
                                "Biblioteca vacía. Pulsa a para añadir una URL de iVoox.")
            elif not self.visible_episodes:
                self.notice("Ningún episodio coincide con la búsqueda. Esc limpia el filtro.")
            else:
                more = " · m carga más" if group.get("next_url") else ""
                self.notice(f"{len(self.visible_episodes)} episodios{more} · o ordena · Enter reproduce")

        def action_sort(self):
            modes = ("newest", "oldest", "title")
            self.sort_mode = modes[(modes.index(self.sort_mode) + 1) % len(modes)]
            self.show_episodes()

        def on_data_table_row_highlighted(self, event: DataTable.RowHighlighted):
            if event.data_table.id == "collections" and event.row_key.value:
                new_key = event.row_key.value
                if new_key != self.group_key:
                    self.clear_episode_filter()
                self.group_key = new_key
                self.show_episodes()
            elif event.data_table.id == "episodes" and self.visible_episodes:
                group = next((g for g in self.groups if g["key"] == self.group_key), None)
                if (group and group.get("next_url") and not group.get("loading") and
                        event.cursor_row >= len(self.visible_episodes) - 2):
                    self.load_account_episodes(group["key"], more=True)

        async def on_data_table_row_selected(self, event: DataTable.RowSelected):
            if event.data_table.id == "collections":
                group = next((g for g in self.groups if g["key"] == self.group_key), None)
                if group and group.get("account") and not group.get("loaded"):
                    self.load_account_episodes(group["key"])
                else:
                    self.query_one("#episodes").focus()
            elif self.visible_episodes:
                self.queue = self.visible_episodes.copy()
                self.queue_index = event.cursor_row
                await self.play_current()

        async def play_current(self):
            if not 0 <= self.queue_index < len(self.queue):
                return
            episode = self.queue[self.queue_index]
            try:
                target = episode.get("path")
                if not target:
                    self.notice("Preparando streaming con tu sesión de iVoox…")
                    target = await asyncio.to_thread(resolve_media, args.config, episode)
                await self.player.play(target)
                self.now_title = episode["title"]
                self.stopped = False
                self.notice("Espacio pausa · s detiene · ←/→ salta 10 s · n/p cambia de episodio")
            except (OSError, ValueError) as exc:
                self.notice(f"No se pudo reproducir: {exc}")

        async def control(self, *command):
            try:
                return await self.player.command(*command)
            except (OSError, ValueError) as exc:
                self.notice(str(exc))
                return None

        async def action_pause(self):
            if self.stopped and self.queue:
                await self.play_current()
            elif self.player.process:
                await self.control("cycle", "pause")
            else:
                self.notice("Selecciona un episodio y pulsa Enter para reproducir")

        async def action_stop(self):
            self.stopped = True
            if self.player.process:
                await self.control("stop")
            self.query_one("#now-playing", Static).update("■  Reproducción detenida")
            self.query_one("#timeline", Static).update("00:00 / 00:00")
            self.query_one("#progress", ProgressBar).update(progress=0)

        async def action_seek(self, seconds):
            if not self.stopped:
                await self.control("seek", seconds, "relative")

        async def action_volume(self, delta):
            if self.player.process:
                volume = await self.control("get_property", "volume")
                if volume is not None:
                    await self.control("set_property", "volume", max(0, min(100, volume + delta)))

        async def action_next_episode(self):
            if self.queue_index + 1 < len(self.queue):
                self.queue_index += 1
                await self.play_current()
            else:
                self.notice("Fin de la lista de reproducción")

        async def action_previous_episode(self):
            if self.queue_index > 0:
                self.queue_index -= 1
                await self.play_current()

        async def update_player(self):
            if not self.player.process or self.stopped or self.closed:
                return
            try:
                idle = await self.player.command("get_property", "idle-active")
                if idle:
                    self.stopped = True
                    self.query_one("#now-playing", Static).update("■  Finalizado · " + self.now_title)
                    return
                position, duration, paused, volume = await asyncio.gather(*(
                    self.player.command("get_property", prop)
                    for prop in ("time-pos", "duration", "pause", "volume")))
                position, duration = position or 0, duration or 0
                symbol = "Ⅱ" if paused else "▶"
                self.query_one("#now-playing", Static).update(f"{symbol}  {self.now_title}")
                def clock(seconds):
                    minutes, seconds = divmod(int(seconds), 60)
                    return f"{minutes:02d}:{seconds:02d}"
                self.query_one("#timeline", Static).update(
                    f"{clock(position)} / {clock(duration)}     Volumen {volume:.0f}%")
                self.query_one("#progress", ProgressBar).update(total=max(duration, 1), progress=position)
            except ValueError:
                pass  # Las propiedades no están disponibles durante loadfile.
            except OSError:
                self.stopped = True
                self.notice("Se ha cerrado mpv. Pulsa Enter para volver a reproducir.")

        def action_search(self):
            if self.focused and self.focused.id in {"collections", "collection-search"}:
                self.action_collection_search()
                return
            field = self.query_one("#search", Input)
            field.add_class("visible")
            field.focus()

        def action_collection_search(self):
            self.query_one("#collection-search", Input).focus()

        def on_input_changed(self, event: Input.Changed):
            if event.input.id == "search":
                self.show_episodes()
            elif event.input.id == "collection-search":
                self.refresh_collection_table()

        def on_input_submitted(self, event: Input.Submitted):
            if event.input.id == "search":
                self.query_one("#episodes").focus()
            elif event.input.id == "collection-search":
                self.query_one("#collections").focus()

        def action_back(self):
            collection_search = self.query_one("#collection-search", Input)
            if self.focused is collection_search or collection_search.value:
                collection_search.value = ""
                self.query_one("#collections").focus()
                return
            field = self.query_one("#search", Input)
            if field.has_class("visible"):
                field.value = ""
                field.remove_class("visible")
                self.query_one("#episodes").focus()
            else:
                self.query_one("#collections").focus()

        def action_help(self):
            self.notify("Tab: panel · ↑↓/j k: navegar · Enter: abrir/reproducir · Espacio: pausa\n"
                        "s: stop · ←→: ±10 s · +/−: volumen · n/p: siguiente/anterior\n"
                        "/: buscar en el panel · f: filtrar podcasts · a: añadir URL\n"
                        "u: descargar colección (10 últimos)\n"
                        "o: ordenar por fecha descendente/ascendente o título\n"
                        "m: otra página · M/botón: lista completa · U: archivar todo\n"
                        "r: actualizar Mi iVoox · Esc: volver · q: salir y detener mpv\n"
                        "☁: cuenta · ⌂: local · ↓: streaming · ●: descargado", timeout=15)

        def action_refresh_account(self):
            if not self.busy:
                self.load_account_collections(True)

        @work(exclusive=True, group="account-collections")
        async def load_account_collections(self, force=False):
            self.notice("Cargando Mis listas y Mis suscripciones de iVoox…")
            try:
                self.account_groups = await asyncio.to_thread(fetch_account_collections, args.config, force)
                if not self.closed:
                    self.action_refresh_library()
                    self.notice(f"Mi iVoox: {len(self.account_groups)} colecciones · Enter abre una")
            except (OSError, ValueError, requests.RequestException) as exc:
                if not self.closed:
                    self.notice(f"No se pudo cargar Mi iVoox: {exc}")

        @work(exclusive=True, group="account-episodes")
        async def load_account_episodes(self, key, more=False):
            group = next((item for item in self.account_groups if item["key"] == key), None)
            if not group or group.get("loading"):
                return
            group["loading"] = True
            row = self.query_one("#episodes", DataTable).cursor_row
            self.notice(f'{"Cargando más" if more else "Cargando"} episodios de {group["title"]}…')
            try:
                items, next_url = await asyncio.to_thread(
                    fetch_account_episode_page, args.config, group["url"],
                    group.get("next_url") if more else None)
                if more:
                    existing = {episode["id"]: episode for episode in group["episodes"]}
                    previous = len(existing)
                    existing.update({episode["id"]: episode for episode in items})
                    group["episodes"] = list(existing.values())
                    if len(existing) == previous:
                        next_url = None
                else:
                    group["episodes"] = items
                group["next_url"] = next_url
                group["loaded"] = True
                group["loading"] = False
                self.group_key = key
                self.action_refresh_library()
                table = self.query_one("#episodes", DataTable)
                if more and table.row_count:
                    table.move_cursor(row=min(row, table.row_count - 1))
                table.focus()
            except (OSError, ValueError, requests.RequestException) as exc:
                self.notice(f"No se pudo abrir la colección: {exc}")
            finally:
                group["loading"] = False

        def action_load_more(self):
            group = next((g for g in self.groups if g["key"] == self.group_key), None)
            if group and group.get("next_url"):
                self.load_account_episodes(group["key"], more=True)
            else:
                self.notice("No hay otra página disponible en esta colección")

        def on_button_pressed(self, event: Button.Pressed):
            if event.button.id == "load-all":
                self.action_load_all()

        def action_load_all(self):
            group = next((g for g in self.groups if g["key"] == self.group_key), None)
            if group and group.get("next_url"):
                self.load_all_account_episodes(group["key"])
            else:
                self.notice("La colección ya está cargada completamente")

        @work(exclusive=True, group="account-all-pages")
        async def load_all_account_episodes(self, key):
            group = next((item for item in self.account_groups if item["key"] == key), None)
            if not group or group.get("loading") or not group.get("next_url"):
                return
            group["loading"] = True
            self.group_key = key
            self.action_refresh_library()
            pages = 0
            final_message = None
            try:
                while group.get("next_url"):
                    items, next_url = await asyncio.to_thread(
                        fetch_account_episode_page, args.config, group["url"], group["next_url"])
                    existing = {episode["id"]: episode for episode in group["episodes"]}
                    previous = len(existing)
                    existing.update({episode["id"]: episode for episode in items})
                    group["episodes"] = list(existing.values())
                    group["next_url"] = next_url if len(existing) > previous else None
                    group["loaded"] = True
                    pages += 1
                    self.action_refresh_library()
                    self.notice(f'Cargando lista completa · {len(existing)} episodios · '
                                f'{pages} páginas nuevas')
                    if group.get("next_url"):
                        await asyncio.sleep(0 if getattr(args, "local_only", False) else 1.0)
                final_message = f'Lista completa: {len(group["episodes"])} episodios'
            except (OSError, ValueError, requests.RequestException) as exc:
                final_message = f"No se pudo completar la lista: {exc}"
            finally:
                group["loading"] = False
                self.action_refresh_library()
                self.query_one("#episodes").focus()
                if final_message:
                    self.notice(final_message)

        def action_add_source(self):
            if not self.busy:
                self.push_screen(AddSource(), self.add_source_result)

        def add_source_result(self, url):
            if url:
                self.cli_job("add", url)

        def action_sync_source(self):
            group = next((g for g in self.groups if g["key"] == self.group_key), None)
            if self.busy:
                self.notice("Ya hay una operación en curso")
            elif group and group["url"]:
                self.cli_job("get", group["url"], "-n", "10")
            else:
                self.notice("Selecciona una fuente añadida con a para descargar sus episodios")

        def action_archive_source(self):
            group = next((g for g in self.groups if g["key"] == self.group_key), None)
            if self.busy:
                self.notice("Ya hay una operación en curso")
                return
            if not group or not group.get("url"):
                self.notice("Selecciona un programa o una suscripción")
                return
            try:
                kind = source(group["url"])[0]
                allowed = kind == "program"
            except ValueError:
                allowed = account_source(group["url"])[0].startswith("account-sub-")
            if not allowed:
                self.notice("El archivado completo se aplica a programas y suscripciones")
                return
            self.push_screen(ConfirmArchive(group["title"]),
                             lambda confirmed: self.archive_result(confirmed, group["url"]))

        def archive_result(self, confirmed, url):
            if confirmed:
                self.cli_job("archive", url)

        @work(exclusive=True, group="cli")
        async def cli_job(self, *arguments):
            self.busy = True
            messages = {
                "add": "Guardando fuente…",
                "get": "Descargando hasta 10 episodios… puedes seguir navegando y escuchando",
                "archive": "Archivando el podcast completo… puedes seguir navegando y escuchando",
            }
            self.notice(messages[arguments[0]])
            try:
                self.job = await asyncio.create_subprocess_exec(
                    sys.executable, str(Path(__file__).resolve()), "--dir", str(args.directory),
                    "--config", str(args.config), *arguments,
                    stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE)
                stdout, stderr = await self.job.communicate()
                if not self.closed:
                    self.action_refresh_library()
                    if self.job.returncode:
                        self.notice("La operación falló; los parciales se conservan para reanudar.")
                        self.notify(stderr.decode(errors="replace")[-1000:], severity="error", timeout=10)
                    elif arguments[0] == "get":
                        result = json.loads(stdout.decode().splitlines()[-1])
                        self.notice(f'Descargados: {result["downloaded"]} · Ya guardados: {result["skipped"]}')
                    elif arguments[0] == "archive":
                        result = json.loads(stdout.decode().splitlines()[-1])
                        self.notice(f'Archivo completo · descargados: {result["downloaded"]} · '
                                    f'ya guardados: {result["skipped"]} · fallidos: {result["failed"]}')
                    else:
                        kind, identifier, _ = source(arguments[1])
                        self.group_key = f"{kind}-{identifier}"
                        self.action_refresh_library()
                        self.notice("Fuente añadida. Pulsa u para descargar sus últimos episodios.")
            except (OSError, ValueError) as exc:
                if not self.closed:
                    self.notice(f"No se pudo completar la operación: {exc}")
            finally:
                if self.job and self.job.returncode is None:
                    self.job.terminate()
                    try:
                        await asyncio.wait_for(self.job.wait(), 5)
                    except TimeoutError:
                        self.job.kill()
                        await self.job.wait()
                self.job = None
                self.busy = False

        async def on_unmount(self):
            self.closed = True
            await self.player.close()

    return IvoxApp()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dir", dest="directory", type=Path,
                        default=Path(os.environ.get("IVX_DIR", "~/Podcasts/ivoox")).expanduser())
    parser.add_argument("--config", type=Path,
                        default=Path(os.environ.get("IVX_CFG", "~/.config/ivx")).expanduser())
    commands = parser.add_subparsers(dest="command", required=True)
    for name in ("get", "sync", "inspect"):
        command = commands.add_parser(name)
        if name != "sync":
            command.add_argument("url")
        command.add_argument("-n", type=positive, default=None if name == "inspect" else 10)
        command.add_argument("-j", type=positive, default=1)
        command.add_argument("--no-rss", action="store_true", help="forzar scraping HTML")
        command.add_argument("--delay", type=float, default=1.5, help="pausa entre páginas (segundos)")
        command.add_argument("--rate", type=positive, default=0, help="límite aproximado en bytes/s por descarga")
        if name == "inspect":
            command.add_argument("--pages", type=positive)
    archive = commands.add_parser("archive", help="descargar todos los episodios de un podcast")
    archive.add_argument("url")
    archive.add_argument("-j", type=positive, default=2, help="descargas simultáneas (por defecto: 2)")
    archive.add_argument("--no-rss", action="store_true", help="forzar scraping HTML")
    archive.add_argument("--delay", type=float, default=1.5, help="pausa entre páginas (segundos)")
    archive.add_argument("--rate", type=positive, default=0,
                         help="límite aproximado en bytes/s por descarga")
    archive.add_argument("--plan", action="store_true",
                         help="contar episodios sin descargar audio")
    commands.add_parser("add").add_argument("url")
    commands.add_parser("ls")
    commands.add_parser("play").add_argument("query", nargs="?", default="")
    tui = commands.add_parser("tui", help="colecciones de la cuenta y reproducción con mpv")
    tui.add_argument("--local", dest="local_only", action="store_true",
                     help="no consultar las colecciones de la cuenta")
    args = parser.parse_args()
    if args.command == "tui":
        if not sys.stdin.isatty() or not sys.stdout.isatty():
            raise ValueError("Abre ivx tui desde una terminal interactiva")
        create_tui(args).run()
        return 0
    if args.command == "inspect":
        with session(args.config) as client:
            items, method, pages = discover(client, args.url, args.n, args.no_rss,
                                            args.pages, max(0, args.delay))
        print(json.dumps({"episodes": items, "method": method, "pages": pages}, ensure_ascii=False))
        return 0
    if args.command == "add":
        kind, identifier, url = source(args.url)
        args.config.mkdir(parents=True, exist_ok=True, mode=0o700)
        with (args.config / "sources.txt").open("a+") as output:
            fcntl.flock(output, fcntl.LOCK_EX)
            output.seek(0)
            existing = output.read().splitlines()
            if not any(source(line)[:2] == (kind, identifier) for line in existing
                       if line.strip() and not line.startswith("#")):
                output.write(url + "\n")
        print(url)
        return 0
    if args.command in {"ls", "play"}:
        files = sorted(args.directory.glob("*/*.mp3"))
        choices = []
        for path in files:
            meta = path.with_suffix(".json")
            title = json.loads(meta.read_text()).get("title", path.stem) if meta.exists() else path.stem
            label = " ".join(title.splitlines()) + "\t" + str(path.resolve())
            if args.command == "ls" or args.query.casefold() in label.casefold():
                choices.append(label)
        if args.command == "ls":
            print("\n".join(choices))
            return 0
        if not choices:
            raise ValueError("No hay audios que coincidan en la biblioteca")
        selected = subprocess.run(["fzf", "--multi", "--delimiter=\t", "--with-nth=1"],
                                  input="\n".join(choices), capture_output=True, text=True, check=False)
        if selected.returncode in {1, 130}:
            return 0
        selected.check_returncode()
        return subprocess.call(["mpv", "--no-video", "--"] +
                               [line.split("\t")[-1] for line in selected.stdout.splitlines()])
    sources = args.config / "sources.txt"
    if args.command == "sync" and not sources.exists():
        log("No hay fuentes. Añádelas con ivx add URL")
        return 0
    args.directory.mkdir(parents=True, exist_ok=True)
    with (args.directory / ".ivx.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ValueError("Ya hay otra descarga o limpieza en esta biblioteca") from None
        if args.command == "get":
            return get(args, args.url)
        if args.command == "archive":
            return get(args, args.url, archive=True)
        failed = False
        for url in sources.read_text().splitlines():
            if url.strip() and not url.startswith("#"):
                try:
                    failed |= get(args, url.strip())
                except (ValueError, OSError, requests.RequestException) as exc:
                    failed = True
                    log(f"ERROR sincronizando {url}: {exc}")
                if STOP.is_set():
                    break
                time.sleep(args.delay)
        return int(failed)


if __name__ == "__main__":
    def interrupt(signum, frame):
        STOP.set()
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, interrupt)
    signal.signal(signal.SIGINT, interrupt)
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        log("Interrumpido; los .part se conservan para reanudar")
        sys.exit(130)
    except (ValueError, OSError, requests.RequestException) as exc:
        log(f"ERROR: {exc}")
        sys.exit(1)
